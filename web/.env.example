# Demo mode uses a bounded illustrative dataset, with no backend required.
VITE_DATA_MODE=demo

# To use the real backend, set VITE_DATA_MODE=api and restart Vite.
# /api is proxied to localhost:8000 during development; change vite.config.js
# to match the backend port, or set an absolute API URL with CORS enabled.
VITE_API_BASE_URL=/api
